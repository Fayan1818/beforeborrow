APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://app:localonly@localhost:5432/bb
FRONTEND_ORIGINS=["http://localhost:5173"]
SESSION_SECRET=replace-with-random-local-secret
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MODEL_VERSION=rules-v1
DEFAULT_HORIZON_DAYS=180
MAX_HORIZON_DAYS=1825
DATA_MODE=manual
ENABLE_DEMO_DATA=true
EXPLANATION_MODE=template
LLM_API_KEY=
MAX_IMPORT_BYTES=1048576
LOG_LEVEL=INFO
